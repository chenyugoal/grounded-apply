#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
cd "$REPO_DIR"

CHECK_RUNTIME_ROOT="${TMPDIR:-/tmp}/grounded-apply-check-$$"
if [ -e "$CHECK_RUNTIME_ROOT" ]; then
    echo "Refusing to reuse check path: $CHECK_RUNTIME_ROOT" >&2
    exit 2
fi

PYTHONDONTWRITEBYTECODE=1 ./scripts/gapply --help >/dev/null
PYTHONDONTWRITEBYTECODE=1 ./scripts/gapply profile decide --help >/dev/null
PYTHONDONTWRITEBYTECODE=1 ./scripts/gapply brief --help >/dev/null
PYTHONDONTWRITEBYTECODE=1 ./scripts/gapply jobs discover --help >/dev/null
PYTHONDONTWRITEBYTECODE=1 ./scripts/gapply batches prepare --help >/dev/null
PYTHONDONTWRITEBYTECODE=1 ./scripts/gapply searches configure --help >/dev/null
PYTHONDONTWRITEBYTECODE=1 ./scripts/gapply searches export --help >/dev/null
PYTHONDONTWRITEBYTECODE=1 ./scripts/gapply schedules configure --help >/dev/null
PYTHONDONTWRITEBYTECODE=1 ./scripts/gapply backup --help >/dev/null
PYTHONDONTWRITEBYTECODE=1 ./scripts/gapply restore --help >/dev/null
PYTHONDONTWRITEBYTECODE=1 GROUNDED_APPLY_HOME="$CHECK_RUNTIME_ROOT" \
    ./scripts/gapply doctor --json >/dev/null
PYTHONDONTWRITEBYTECODE=1 GROUNDED_APPLY_HOME="$CHECK_RUNTIME_ROOT" \
    ./scripts/gapply --log-events doctor --json >/dev/null 2>/dev/null
PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=src \
    sh "$SCRIPT_DIR/python" -W error -m unittest discover -s tests -v
